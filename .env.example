# NetReplay Environment Configuration Template
# Copy this file to .env if you wish to override default host ports.
# Defaults match standard NetReplay configuration.

# Direct Test Target host port (default: 3000)
TEST_TARGET_PORT=3000

# Toxiproxy Control API host port (default: 8474)
TOXIPROXY_CONTROL_PORT=8474

# Toxiproxy Fault-Injection Proxy host listener port (default: 8666)
TOXIPROXY_LISTEN_PORT=8666

# Node environment
NODE_ENV=production

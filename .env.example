# ==============================================================================
# NetReplay — Master Environment Configuration Template (.env.example)
#
# Copy this file to .env for local customization.
# All settings below have safe, non-sensitive defaults for local development.
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# ==============================================================================

# Node Environment ('development', 'production', or 'test')
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Services Host Ports (Docker Compose & Local Binding)
# ------------------------------------------------------------------------------
# Direct Test Target host port
TEST_TARGET_PORT=3000

# Toxiproxy Control API port (SECURITY WARNING: Keep bound to 127.0.0.1; NEVER expose publicly)
TOXIPROXY_CONTROL_PORT=8474

# Toxiproxy Fault-Injection Traffic listener port
TOXIPROXY_LISTEN_PORT=8666

# NetReplay Fastify API server port & host interface
API_PORT=3100
API_HOST=127.0.0.1

# NetReplay React Dashboard port (Local Vite dev server or Docker Nginx)
WEB_PORT=5173

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# SQLite connection string used by Prisma ORM
DATABASE_URL="file:../prisma/dev.db"

# ------------------------------------------------------------------------------
# 3. Toxiproxy & Target URL Resolution
# ------------------------------------------------------------------------------
# Internal or local loopback URL for Toxiproxy HTTP management
TOXIPROXY_CONTROL_URL=http://127.0.0.1:8474

# Name of the primary Toxiproxy proxy used by NetReplay
TOXIPROXY_PROXY_NAME=netreplay-demo

# Explicitly permitted test target URLs (Direct baseline and Faulted proxy)
TEST_TARGET_DIRECT_URL=http://127.0.0.1:3000
TEST_TARGET_PROXY_URL=http://127.0.0.1:8666

# ------------------------------------------------------------------------------
# 4. Security & Hardening Boundaries
# ------------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins for the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Request body size limit in bytes (Default: 1048576 = 1MB)
REQUEST_BODY_LIMIT_BYTES=1048576

# API connection timeout in milliseconds (Default: 30000 = 30s)
CONNECTION_TIMEOUT_MS=30000

# Application log verbosity ('info', 'warn', 'error', 'debug', or 'silent')
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 5. Frontend Client Configuration (Vite Public Environment Variables)
# NOTE: VITE_* variables are bundled into client-side JS. NEVER put secrets here.
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:3100

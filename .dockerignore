# Ignore node_modules from host machine
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore environment files containing potential secrets
.env
.env.*
!.env.example

# Ignore build artifacts and caches
dist/
build/
coverage/
.turbo/
.cache/

# Ignore local databases and logs
*.db
*.db-journal
*.db-wal
*.db-shm
logs/
*.log

# Ignore git and documentation
.git/
.github/
.vscode/
.idea/
*.md
!README.md

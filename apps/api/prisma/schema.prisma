// Prisma schema for NetReplay SQLite experiment storage

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String   @id @default(cuid())
  name        String
  description String?
  engine      String   @default("toxiproxy")
  config      String   // Serialized JSON of validated target, faults, counts, criteria
  tags        String?  // Serialized JSON array of tags
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs        Run[]

  @@index([createdAt])
}

model Run {
  id              String          @id @default(cuid())
  profileId       String?
  replayedFromId  String?
  status          String          @default("queued") // queued, preparing, running, collecting, completed, failed, cancelled
  configSnapshot  String          // Serialized JSON of complete configuration executed
  startedAt       DateTime?
  finishedAt      DateTime?
  summary         String?         // Serialized JSON statistics (median, mean, counts, etc.)
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  profile         Profile?        @relation(fields: [profileId], references: [id], onDelete: SetNull)
  requests        RequestResult[]
  events          RunEvent[]
  minimizations   Minimization[]

  @@index([profileId])
  @@index([status])
  @@index([createdAt])
}

model RequestResult {
  id            String   @id @default(cuid())
  runId         String
  requestIndex  Int
  outcome       String   // success, failure, timeout
  statusCode    Int?
  latencyMs     Float
  errorCategory String?
  timestamp     DateTime @default(now())

  run           Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([runId, requestIndex])
}

model RunEvent {
  id        String   @id @default(cuid())
  runId     String
  eventType String   // state_change, fault_applied, fault_removed, batch_started, batch_completed, cancelled, error
  timestamp DateTime @default(now())
  details   String?  // Serialized JSON details

  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([runId, timestamp])
}

model Minimization {
  id                     String                @id @default(cuid())
  sourceRunId            String
  status                 String                @default("queued") // queued, running, completed, failed, cancelled, budget_exhausted, baseline_not_reproducible
  originalConfigSnapshot String                // Serialized JSON of original run's snapshot
  minimizedConfig        String?               // Serialized JSON of simplest working configuration found
  predicate              String                // Serialized JSON of failure predicate
  minReproductionRate    Float                 @default(1.0)
  strategy               String                @default("staged_delta_debugging")
  maxAttempts            Int                   @default(50)
  attemptsUsed           Int                   @default(0)
  trialsPerCandidate     Int                   @default(1)
  finalTrials            Int                   @default(3)
  finalObservedRate      Float?
  cleanupStatus          String                @default("cleaned") // cleaned, cleanup_failed
  startedAt              DateTime?
  finishedAt             DateTime?
  durationMs             Int?
  errorCode              String?
  errorMessage           String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  sourceRun              Run                   @relation(fields: [sourceRunId], references: [id], onDelete: Cascade)
  attempts               MinimizationAttempt[]

  @@index([sourceRunId])
  @@index([status])
  @@index([createdAt])
}

model MinimizationAttempt {
  id               String       @id @default(cuid())
  minimizationId   String
  attemptNumber    Int
  stage            String       // baseline, component_reduction, parameter_minimization, verification
  changeDesc       String       // Human-readable description of change being evaluated
  candidateConfig  String       // Serialized JSON of candidate faults
  triggered        Boolean      // Whether target failure was reproduced
  trialCount       Int
  failedTrials     Int
  reproductionRate Float
  durationMs       Int
  outcome          String       // kept, rejected, baseline_verified, baseline_failed, verified
  reason           String?
  details          String?      // Serialized JSON details / trialResults
  timestamp        DateTime     @default(now())

  minimization     Minimization @relation(fields: [minimizationId], references: [id], onDelete: Cascade)

  @@index([minimizationId])
  @@index([minimizationId, attemptNumber])
}
